{
  "appId": "org.canvas.lan",
  "productName": "Canvas",
  "asar": true,
  "electronDist": "node_modules/electron/dist",
  "directories": {
    "output": "dist/installers"
  },
  "files": [
    "dist/client/**/*",
    "package.json"
  ],
  "extraMetadata": {
    "main": "dist/client/main.cjs"
  },
  "win": {
    "signAndEditExecutable": false,
    "target": [
      "portable"
    ],
    "artifactName": "Canvas-${version}-windows-${arch}.${ext}",
    "icon": "build/icon.ico"
  },
  "linux": {
    "target": [
      "AppImage"
    ],
    "category": "Education",
    "artifactName": "Canvas-${version}-linux-${arch}.${ext}",
    "icon": "build/icon.png"
  },
  "mac": {
    "target": [
      "dmg"
    ],
    "category": "public.app-category.education",
    "artifactName": "Canvas-${version}-mac-${arch}.${ext}"
  },
  "npmRebuild": false,
  "icon": "build/icon.png"
}
