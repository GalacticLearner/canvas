{
  "name": "canvas-lan",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:server": "tsx packages/server/src/main.ts",
    "dev:client": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "package:server": "node scripts/package-server.mjs",
    "package:client": "npm run build && electron-builder --config packages/client/builder.json",
    "package:source": "powershell -NoProfile -File scripts/source.ps1",
    "seed": "tsx tools/seed/index.ts",
    "loadtest": "tsx tools/loadtest/index.ts",
    "test:e2e": "node tools/e2e/smoke.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "tsx": "^4.20.6",
    "vitest": "^3.2.4",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.0",
    "typescript-eslint": "^8.46.0",
    "@types/node": "^22.18.0",
    "esbuild": "^0.25.11",
    "prettier": "^3.6.2",
    "electron": "latest",
    "electron-builder": "^26.0.12",
    "@yao-pkg/pkg": "^6.10.0",
    "vite": "^6.4.1",
    "@vitejs/plugin-react": "^4.7.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@playwright/test": "^1.56.0",
    "@types/rbush": "^4.0.0"
  },
  "dependencies": {
    "zod": "^3.25.76",
    "fractional-indexing": "^3.2.0",
    "rbush": "^4.0.1",
    "jspdf": "^3.0.3",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.8",
    "@fontsource-variable/public-sans": "^5.2.7",
    "@fontsource-variable/newsreader": "^5.2.8"
  }
}
