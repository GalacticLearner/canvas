{
  "name": "canvas-lan",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:server": "tsx packages/server/src/main.ts",
    "dev:client": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "package:server": "node scripts/package-server.mjs",
    "package:client": "npm run build && electron-builder --config packages/client/builder.json",
    "package:source": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/source.ps1",
    "seed": "tsx tools/seed/index.ts",
    "loadtest": "tsx tools/loadtest/index.ts",
    "test:e2e": "node tools/e2e/smoke.mjs",
    "verify:server": "tsx tools/verify-server/index.ts"
    ,"verify:demo": "node --import tsx tools/seed/verify.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.18.0",
    "@types/rbush": "^4.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^5.1.0",
    "@yao-pkg/pkg": "^6.10.0",
    "electron": "latest",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.11",
    "eslint": "^9.39.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^6.4.1",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@fontsource-variable/newsreader": "^5.2.8",
    "@fontsource-variable/public-sans": "^5.2.7",
    "fractional-indexing": "^3.2.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.468.0",
    "rbush": "^4.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.8"
  },
  "description": "Offline LAN collaborative whiteboard",
  "author": "Canvas project"
}
